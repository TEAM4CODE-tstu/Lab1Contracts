<Window x:Class="SortingAggregator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SortingAggregator.ViewModels"
        Title="Операции — Сортировка и агрегация"
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Конвертер bool → зелёный/красный -->
        <Style x:Key="IndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="Gray"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreMet}" Value="True">
                    <Setter Property="Fill" Value="LightGreen"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPreMet}" Value="False">
                    <Setter Property="Fill" Value="IndianRed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список операций слева -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Operations}"
                 DisplayMemberPath="DisplayName"
                 SelectedItem="{Binding SelectedOperation}"
                 Margin="8"/>

        <!-- Карточка операции справа -->
        <Border Grid.Column="1" Margin="8" Padding="16"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedOperation}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Заголовок -->
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Ввод -->
                    <TextBlock Text="Введите числа (через пробел, запятую или ;):" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" Padding="4"/>

                    <!-- Кнопка выполнить -->
                    <Button Content="Выполнить"
                            Command="{Binding ExecuteCommand}"
                            Width="120" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,0,0,16"/>

                    <!-- Индикаторы Pre / Post -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Style="{StaticResource IndicatorStyle}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PreStatus}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Gray"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPostMet}" Value="True">
                                            <Setter Property="Fill" Value="LightGreen"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPostMet}" Value="False">
                                            <Setter Property="Fill" Value="IndianRed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding PostStatus}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Результат -->
                    <TextBlock Text="Результат:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ResultText, TargetNullValue='—'}"
                               FontFamily="Consolas" FontSize="14"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Кнопка контракт -->
                    <Button Content="Показать контракт"
                            Command="{Binding ShowContractCommand}"
                            Width="160" HorizontalAlignment="Left"
                            Padding="8,4"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
